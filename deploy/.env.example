# =============================================================================
# VJ Play — variables para `deploy/docker-compose.yml`
# Copiar:  cp .env.example .env   y completar (nunca commitear .env).
# =============================================================================

# --- Imágenes Docker ---
# Build solo en la VPS: omití IMAGE_REGISTRY (usa "local" por defecto).
# Build en PC + push: docker.io/tuusuario  o  ghcr.io/tuusuario
# IMAGE_REGISTRY=docker.io/TU_USUARIO_DOCKERHUB
# IMAGE_TAG=latest

# --- URL pública del stack (IP o dominio de la VM, sin barra final) ---
# Con Caddy en :80, el API queda en la misma raíz: http://TU_IP/api/...
SITE_HOST=http://TU_IP_PUBLICA_GCP
PUBLIC_REPLAY_API_BASE=http://TU_IP_PUBLICA_GCP

# CORS del backend: mismo origen que el navegador (sitio en :80)
CORS_ORIGINS=http://http://136.112.74.172/

# Modo despliegue (backend + recorder en VPS)
VJ_RUNTIME=vps
NODE_ENV=production

# --- Backend API (obligatorias) ---
PORT=4000
JWT_SESSION_SECRET=genera_un_secreto_largo_aleatorio

# ADMIN_SECRET=opcional_mismo_valor_que_PUBLIC_REPLAY_ADMIN_SECRET_en_build

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=

# Marca de agua (ruta DENTRO del contenedor backend; por defecto vacío)
# WATERMARK_PNG_PATH=/app/assets/escudo-varela-junior.png

# --- Frontend (build-time; requiere rebuild si cambian) ---
# PUBLIC_REPLAY_ADMIN_SECRET=
# PUBLIC_REPLAY_WHATSAPP_URL=
# PUBLIC_REPLAY_SHIFT_DURATION_SECONDS=3600
# PUBLIC_REPLAY_SHIFTS_WINDOW_START_HOUR=9
# PUBLIC_REPLAY_SHIFTS_WINDOW_END_HOUR=24

# --- Recorder (solo con: docker compose --profile recorder up -d) ---
# WireGuard debe estar activo en el HOST (wg0) antes de levantar el recorder.
# RECORDER_ALLOW_HEARTBEAT_IN_LOCAL=false
DVR_RTSP_USER=recorder
DVR_RTSP_PASSWORD=
DVR_HOST=192.168.88.10
DVR_RTSP_PORT=554
DVR_RTSP_URL_TEMPLATE=rtsp://{user}:{password}@{host}:{port}/cam/realmonitor?channel={channel}&subtype={subtype}
TENANT_ID=cvj
RECORDING_SEGMENT_SECONDS=3600
RECORDING_LOCAL_BUFFER_DIR=/var/lib/vjplay-recorder
RECORDING_LOCAL_RETENTION_HOURS=24
RECORDING_SHIFTS_WINDOW_START_HOUR=9
RECORDING_SHIFTS_WINDOW_END_HOUR=24
RECORDING_TIMEZONE=America/Argentina/Buenos_Aires
RECORDING_VIDEO_MODE=copy
RECORDER_HEARTBEAT_INTERVAL_SECONDS=30
RECORDER_HOST_LABEL=gcp-docker-1
LOG_LEVEL=info
