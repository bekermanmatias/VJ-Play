---
import { navDropdowns, navSimpleLinks } from "@/data/nav";
import type { NavGroup } from "@/data/nav";

const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const isItemActive = (href: string) => {
  const path = href.split("?")[0];
  return path === currentPath;
};

/** Solo un ítem del grupo puede coincidir; no usar group.href (varios grupos comparten `/deportes`). */
const isGroupActive = (group: NavGroup) =>
  group.items.some((item) => isItemActive(item.href));

const linkTitle = (label: string): string | undefined => {
  if (label === "Socios") return "Cuota social, beneficios y reglamentos";
  if (label === "Noticias") return "Novedades, eventos y comunicados del club";
  return undefined;
};
---

<header class="sticky top-0 z-40 bg-white shadow-sm" data-mobile-nav>
  <nav
    class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-24 flex items-center gap-5"
    aria-label="Navegación principal"
  >
    <!-- Marca: escudo + nombre -->
    <a
      href="/"
      class="flex items-center gap-3 shrink-0"
      aria-label="Club Social Varela Junior - Inicio"
    >
      <img
        src="/images/escudo-varela-junior.png"
        alt="Escudo Club Social Varela Junior"
        class="h-14 w-auto shrink-0 object-contain"
        loading="eager"
        decoding="async"
      />

      <span class="hidden sm:flex flex-col leading-none antialiased">
        <span class="text-base font-extrabold uppercase tracking-[0.04em] text-slate-900"
          >Club Social</span
        >
        <span class="mt-1 text-[1.85rem] font-black uppercase tracking-tight text-vj-green"
          >Varela Junior</span
        >
      </span>
    </a>

    <!-- Links centrales -->
    <ul class="hidden lg:flex items-center gap-0.5 ml-auto">
      {
        navDropdowns.map((grupo) => {
          const groupActive = isGroupActive(grupo);
          return (
            <li class="relative group">
              <button
                type="button"
                class:list={[
                  "px-2.5 py-2 text-sm font-bold uppercase tracking-wide transition-colors inline-flex items-center gap-1",
                  groupActive
                    ? "bg-slate-100 text-slate-900"
                    : "text-slate-700 hover:text-vj-green hover:bg-slate-50",
                ]}
                aria-haspopup="true"
                aria-expanded="false"
              >
                {grupo.label}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="w-3.5 h-3.5"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>

              <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-150 absolute left-1/2 top-full z-50 -translate-x-1/2 pt-3">
                <div class="overflow-hidden border border-slate-200 bg-white shadow-xl">
                  <ul class="grid w-[22rem] grid-cols-1">
                    {grupo.items.map((item) => {
                      const active = isItemActive(item.href);
                      return (
                        <li class="-mb-px border-b border-slate-200 last:border-b-0">
                          <a
                            href={item.href}
                            aria-current={active ? "page" : undefined}
                            class:list={[
                              "block px-6 py-3.5 text-sm font-bold uppercase tracking-wide transition-colors",
                              active
                                ? "bg-slate-100 text-vj-green"
                                : "text-slate-700 hover:bg-slate-50 hover:text-vj-green",
                            ]}
                          >
                            {item.label}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </div>
            </li>
          );
        })
      }

      {
        navSimpleLinks.map((link) => {
          const active = isActive(link.href);
          const isReplays = link.icon === "replays";
          return (
            <li>
              <a
                href={link.href}
                class:list={[
                  "px-2.5 py-2 text-sm font-bold uppercase tracking-wide transition-colors inline-flex items-center gap-1.5",
                  active
                    ? "bg-slate-100 text-slate-900"
                    : "text-slate-700 hover:text-vj-green hover:bg-slate-50",
                ]}
                aria-current={active ? "page" : undefined}
                title={linkTitle(link.label)}
              >
                {
                  isReplays && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="w-3.5 h-3.5 text-vj-green"
                      aria-hidden="true"
                    >
                      <path d="M8 6.82v10.36c0 .79.87 1.27 1.54.84l8.14-5.18a1 1 0 0 0 0-1.68L9.54 5.98A1 1 0 0 0 8 6.82Z"></path>
                    </svg>
                  )
                }
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <!-- Herramientas -->
    <div class="ml-auto flex items-center gap-1 sm:gap-2 lg:ml-3">
      <!-- Toggle del menú mobile -->
      <button
        type="button"
        class="lg:hidden p-2 text-slate-700 hover:text-vj-green hover:bg-slate-50 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        data-mobile-menu-toggle
      >
        <svg
          data-mobile-menu-icon-open
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-6 h-6"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg
          data-mobile-menu-icon-close
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden w-6 h-6"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu-panel"
    class="max-h-0 translate-y-[-8px] overflow-hidden border-t border-transparent bg-white px-4 py-0 opacity-0 pointer-events-none transition-[max-height,opacity,transform,padding,border-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] lg:hidden"
    data-mobile-menu-panel
  >
    <nav aria-label="Menu movil principal">
      {
        navDropdowns.map((grupo) => (
          <div class="border-b border-slate-200 py-3 first:pt-0">
            <p class="px-3 text-xs font-black uppercase tracking-[0.15em] text-slate-500">
              {grupo.label}
            </p>
            <ul class="mt-2 space-y-1">
              {grupo.items.map((item) => {
                const active = isItemActive(item.href);
                return (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        "block px-3 py-2 text-sm font-bold uppercase tracking-wide transition-colors",
                        active
                          ? "bg-slate-100 text-vj-green"
                          : "text-slate-700 hover:bg-slate-50 hover:text-vj-green",
                      ]}
                      aria-current={active ? "page" : undefined}
                      data-mobile-menu-link
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }

      <ul class="space-y-1 py-3">
        {
          navSimpleLinks.map((link) => {
            const active = isActive(link.href);
            const isReplays = link.icon === "replays";
            return (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "flex items-center gap-2 px-3 py-2 text-sm font-bold uppercase tracking-wide transition-colors",
                    active
                      ? "bg-slate-100 text-slate-900"
                      : "text-slate-700 hover:bg-slate-50 hover:text-vj-green",
                  ]}
                  aria-current={active ? "page" : undefined}
                  data-mobile-menu-link
                >
                  {
                    isReplays && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="h-4 w-4 text-vj-green"
                        aria-hidden="true"
                      >
                        <path d="M8 6.82v10.36c0 .79.87 1.27 1.54.84l8.14-5.18a1 1 0 0 0 0-1.68L9.54 5.98A1 1 0 0 0 8 6.82Z"></path>
                      </svg>
                    )
                  }
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  (() => {
    const root = document.querySelector("[data-mobile-nav]");
    if (!root) return;

    const toggle = root.querySelector("[data-mobile-menu-toggle]");
    const panel = root.querySelector("[data-mobile-menu-panel]");
    const links = root.querySelectorAll("[data-mobile-menu-link]");
    const openIcon = root.querySelector("[data-mobile-menu-icon-open]");
    const closeIcon = root.querySelector("[data-mobile-menu-icon-close]");
    if (!toggle || !panel) return;

    const setGlobalOffset = () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      const offset = expanded ? `${Math.round(root.getBoundingClientRect().height)}px` : "0px";
      document.documentElement.style.setProperty("--mobile-nav-offset", offset);
    };

    const closeMenu = () => {
      panel.classList.add(
        "max-h-0",
        "opacity-0",
        "translate-y-[-6px]",
        "py-0",
        "pointer-events-none",
        "border-transparent",
      );
      panel.classList.remove(
        "max-h-[75vh]",
        "opacity-100",
        "translate-y-0",
        "py-3",
        "pointer-events-auto",
        "border-slate-200",
      );
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menú");
      openIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
      setGlobalOffset();
    };

    const openMenu = () => {
      panel.classList.remove(
        "max-h-0",
        "opacity-0",
        "translate-y-[-6px]",
        "py-0",
        "pointer-events-none",
        "border-transparent",
      );
      panel.classList.add(
        "max-h-[75vh]",
        "opacity-100",
        "translate-y-0",
        "py-3",
        "pointer-events-auto",
        "border-slate-200",
      );
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Cerrar menú");
      openIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
      setGlobalOffset();
    };

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        closeMenu();
        return;
      }
      openMenu();
    });

    links.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("mobile-nav:close", closeMenu);

    document.addEventListener("pointerdown", (event) => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      if (!isOpen) return;
      if (!(event.target instanceof Node)) return;
      if (root.contains(event.target)) return;
      closeMenu();
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024) {
        closeMenu();
        return;
      }
      setGlobalOffset();
    });

    setGlobalOffset();
  })();
</script>
