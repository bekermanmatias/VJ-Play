---
import { navDropdowns, navSimpleLinks } from "@/data/nav";
import type { NavGroup } from "@/data/nav";

const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const isItemActive = (href: string) => {
  const path = href.split("#")[0]!.split("?")[0]!;
  return path === currentPath;
};

/** Solo un ítem del grupo puede coincidir; no usar group.href (varios grupos comparten `/deportes`). */
const isGroupActive = (group: NavGroup) =>
  group.items.some((item) => isItemActive(item.href));

const mobileOpenGroups = new Set(
  navDropdowns.filter((group) => isGroupActive(group)).map((group) => group.label),
);

const linkTitle = (label: string): string | undefined => {
  if (label === "Socios") return "Cuota social, beneficios y reglamentos";
  if (label === "Noticias") return "Novedades, eventos y comunicados del club";
  return undefined;
};
---

<header class="sticky top-0 z-40 bg-white shadow-sm" data-mobile-nav>
  <nav
    class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-24 flex items-center gap-5"
    aria-label="Navegación principal"
  >
    <!-- Marca: escudo + nombre -->
    <a
      href="/"
      class="flex items-center gap-3 shrink-0"
      aria-label="Club Social Varela Junior - Inicio"
    >
      <img
        src="/images/escudo-varela-junior.png"
        alt="Escudo Club Social Varela Junior"
        class="h-14 w-auto shrink-0 object-contain"
        loading="eager"
        decoding="async"
      />

      <span class="hidden sm:flex flex-col leading-none antialiased">
        <span class="text-base font-extrabold uppercase tracking-[0.04em] text-slate-900"
          >Club Social</span
        >
        <span class="mt-1 text-[1.85rem] font-black uppercase tracking-tight text-vj-green"
          >Varela Junior</span
        >
      </span>
    </a>

    <!-- Links centrales -->
    <ul class="hidden lg:flex items-center gap-0.5 ml-auto">
      {
        navDropdowns.map((grupo) => {
          const groupActive = isGroupActive(grupo);
          return (
            <li class="relative group">
              <button
                type="button"
                class:list={[
                  "px-2.5 py-2 text-sm font-bold uppercase tracking-wide transition-colors inline-flex items-center gap-1",
                  groupActive
                    ? "bg-slate-100 text-slate-900"
                    : "text-slate-700 hover:text-vj-green hover:bg-slate-50",
                ]}
                aria-haspopup="true"
                aria-expanded="false"
              >
                {grupo.label}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="w-3.5 h-3.5"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>

              <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-150 absolute left-1/2 top-full z-50 -translate-x-1/2 pt-3">
                <div class="overflow-hidden border border-slate-200 bg-white shadow-xl">
                  <ul class="grid w-[22rem] grid-cols-1">
                    {grupo.items.map((item) => {
                      const active = isItemActive(item.href);
                      return (
                        <li class="-mb-px border-b border-slate-200 last:border-b-0">
                          <a
                            href={item.href}
                            aria-current={active ? "page" : undefined}
                            class:list={[
                              "block px-6 py-3.5 text-sm font-bold uppercase tracking-wide transition-colors",
                              active
                                ? "bg-slate-100 text-vj-green"
                                : "text-slate-700 hover:bg-slate-50 hover:text-vj-green",
                            ]}
                          >
                            {item.label}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </div>
            </li>
          );
        })
      }

      {
        navSimpleLinks.map((link) => {
          const active = isActive(link.href);
          const isReplays = link.icon === "replays";
          return (
            <li>
              <a
                href={link.href}
                class:list={[
                  "px-2.5 py-2 text-sm font-bold uppercase tracking-wide transition-colors inline-flex items-center gap-1.5",
                  active
                    ? "bg-slate-100 text-slate-900"
                    : "text-slate-700 hover:text-vj-green hover:bg-slate-50",
                ]}
                aria-current={active ? "page" : undefined}
                title={linkTitle(link.label)}
              >
                {
                  isReplays && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="w-3.5 h-3.5 text-vj-green"
                      aria-hidden="true"
                    >
                      <path d="M8 6.82v10.36c0 .79.87 1.27 1.54.84l8.14-5.18a1 1 0 0 0 0-1.68L9.54 5.98A1 1 0 0 0 8 6.82Z"></path>
                    </svg>
                  )
                }
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <!-- Herramientas -->
    <div class="ml-auto flex items-center gap-1 sm:gap-2 lg:ml-3">
      <!-- Toggle del menú mobile -->
      <button
        type="button"
        class="lg:hidden p-2 text-slate-700 hover:text-vj-green hover:bg-slate-50 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        data-mobile-menu-toggle
      >
        <svg
          data-mobile-menu-icon-open
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-6 h-6"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg
          data-mobile-menu-icon-close
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden w-6 h-6"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- ═══ Menú mobile fullscreen (fuera del header, position: fixed) ═══ -->
<div
  id="mobile-menu-panel"
  class="mobile-menu-fullscreen lg:hidden"
  data-mobile-menu-panel
  data-state="closed"
  aria-label="Menu movil principal"
  role="dialog"
  aria-modal="true"
>
  <!-- Header del menú: escudo + cerrar -->
  <div class="mobile-menu-header">
    <a href="/" class="shrink-0" aria-label="Club Social Varela Junior - Inicio">
      <img
        src="/images/escudo-varela-junior.png"
        alt="Escudo Club Social Varela Junior"
        class="h-14 w-auto shrink-0 object-contain"
        loading="eager"
        decoding="async"
      />
    </a>

    <button
      type="button"
      class="p-2 text-slate-400 hover:text-white transition-colors"
      aria-label="Cerrar menú"
      data-mobile-menu-close
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-6 h-6"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Contenido scrolleable -->
  <div class="mobile-menu-body">
    <nav>
      {
        navDropdowns.map((grupo) => (
          <details
            class="mobile-menu-group"
            open={mobileOpenGroups.has(grupo.label)}
          >
            <summary class="mobile-menu-summary">
              <span>{grupo.label}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4 shrink-0 transition-transform duration-200"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="mobile-accordion-body">
              <ul class="mt-1 space-y-0.5 pb-1">
                {grupo.items.map((item) => {
                  const active = isItemActive(item.href);
                  return (
                    <li>
                      <a
                        href={item.href}
                        class:list={[
                          "mobile-menu-link",
                          active && "mobile-menu-link--active",
                        ]}
                        aria-current={active ? "page" : undefined}
                        data-mobile-menu-link
                      >
                        {item.label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </details>
        ))
      }

      <div class="mobile-menu-simple-links">
        {
          navSimpleLinks.map((link) => {
            const active = isActive(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  "mobile-menu-simple-link",
                  active && "mobile-menu-simple-link--active",
                ]}
                aria-current={active ? "page" : undefined}
                data-mobile-menu-link
              >
                {link.label}
              </a>
            );
          })
        }
      </div>
    </nav>
  </div>
</div>

<script>
  (() => {
    const toggle = document.querySelector("[data-mobile-menu-toggle]");
    const panel = document.querySelector("[data-mobile-menu-panel]");
    const closeBtn = document.querySelector("[data-mobile-menu-close]");
    const links = document.querySelectorAll("[data-mobile-menu-link]");
    const openIcon = document.querySelector("[data-mobile-menu-icon-open]");
    const closeIcon = document.querySelector("[data-mobile-menu-icon-close]");

    if (!toggle || !panel) return;

    let isOpen = false;
    let resizeTimer = 0;

    /* ── Abrir / Cerrar ── */
    const setState = (open) => {
      if (open === isOpen) return;
      isOpen = open;

      panel.setAttribute("data-state", open ? "open" : "closed");

      // Accesibilidad del toggle en la barra
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");

      // Íconos del hamburger
      if (open) {
        openIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
      } else {
        openIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      }

      // Scroll lock en el body
      if (open) {
        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";
      } else {
        document.documentElement.style.overflow = "";
        document.body.style.overflow = "";
      }
    };

    const closeMenu = () => setState(false);

    /* ── Events ── */

    // Hamburger en la barra
    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      setState(!isOpen);
    });

    // Botón X dentro del panel fullscreen
    closeBtn?.addEventListener("click", closeMenu);

    // Links cierran el menú al navegar
    links.forEach((link) => link.addEventListener("click", closeMenu));

    // Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        closeMenu();
        toggle.focus();
      }
    });

    // Custom event
    document.addEventListener("mobile-nav:close", closeMenu);

    // Resize → cerrar si pasa a desktop
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (window.innerWidth >= 1024) setState(false);
      }, 100);
    });
  })();
</script>

<style>
  /* ═══ Panel fullscreen ═══ */
  .mobile-menu-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    background: rgb(15 23 42); /* slate-900 */
    color: white;

    /* Cerrado: invisible y desplazado */
    opacity: 0;
    visibility: hidden;
    transform: translateX(100%);
    pointer-events: none;

    transition:
      opacity 350ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0ms 400ms; /* delay hide visibility */
  }

  .mobile-menu-fullscreen[data-state="open"] {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    pointer-events: auto;
    transition:
      opacity 350ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0ms 0ms; /* show immediately */
  }

  /* ═══ Header del menú ═══ */
  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgb(51 65 85); /* slate-700 */
    flex-shrink: 0;
  }




  /* ═══ Body scrolleable ═══ */
  .mobile-menu-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 1rem 1.5rem 2rem;
  }

  /* ═══ Grupos / accordions ═══ */
  .mobile-menu-group {
    border-bottom: 1px solid rgb(51 65 85);
  }

  .mobile-menu-summary {
    display: flex;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0.25rem;
    font-size: 0.8125rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgb(203 213 225); /* slate-300 */
    transition: color 200ms ease;
  }
  .mobile-menu-summary::-webkit-details-marker { display: none; }
  .mobile-menu-summary:hover { color: white; }

  /* ═══ Links dentro de accordions ═══ */
  .mobile-menu-link {
    display: block;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(148 163 184); /* slate-400 */
    border-radius: 0.5rem;
    transition: all 200ms ease;
  }
  .mobile-menu-link:hover {
    color: white;
    background: rgb(30 41 59); /* slate-800 */
  }
  .mobile-menu-link--active {
    color: rgb(1 170 85); /* vj-green */
    background: rgb(30 41 59);
  }

  /* ═══ Links simples (Noticias, Replays, Socios) ═══ */
  .mobile-menu-simple-links {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu-simple-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 0.25rem;
    font-size: 0.8125rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgb(203 213 225);
    border-bottom: 1px solid rgb(51 65 85);
    transition: color 200ms ease;
  }
  .mobile-menu-simple-link:last-child { border-bottom: none; }
  .mobile-menu-simple-link:hover { color: white; }
  .mobile-menu-simple-link--active { color: rgb(1 170 85); }

  /* ═══ Accordion body ═══ */
  .mobile-accordion-body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    overflow: hidden;
    transition:
      grid-template-rows 240ms ease,
      opacity 180ms ease;
  }

  .mobile-accordion-body > ul {
    min-height: 0;
  }

  details[open] > .mobile-accordion-body {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  details[open] > .mobile-menu-summary svg {
    transform: rotate(180deg);
  }
</style>
