---
// Franja verde de Autoridades — datos propios de la sección
---

<section
  class="bg-gradient-to-r from-[#018b45] to-[#01a050] py-12"
  aria-label="Datos de las autoridades históricas"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col divide-y divide-white/20 md:flex-row md:divide-x md:divide-y-0">

      <!-- Cifra 1 -->
      <div class="flex flex-1 flex-col items-center justify-center py-6 text-center px-4 md:py-0">
        <span class="font-display text-5xl font-black text-white drop-shadow-sm">32</span>
        <span class="mt-2 text-xs font-bold uppercase tracking-[0.15em] text-white/90">Presidentes históricos</span>
      </div>

      <!-- Cifra 2 -->
      <div class="flex flex-1 flex-col items-center justify-center py-6 text-center px-4 md:py-0">
        <span class="font-display text-5xl font-black text-white drop-shadow-sm">+115</span>
        <span class="mt-2 text-xs font-bold uppercase tracking-[0.15em] text-white/90">Años de conducción</span>
      </div>

      <!-- Cifra 3: CTA -->
      <div class="flex flex-1 flex-col items-center justify-center py-6 text-center px-4 md:py-0">
        <span class="font-display text-5xl font-black text-white drop-shadow-sm">1906</span>
        <span class="mt-2 text-xs font-bold uppercase tracking-[0.15em] text-white/90">Año de fundación</span>
      </div>

    </div>
  </div>
</section>
