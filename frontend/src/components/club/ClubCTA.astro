---
interface Props {
  exclude?: "institucional" | "historia" | "autoridades";
}

const { exclude = "institucional" } = Astro.props;

const allBanners = [
  {
    id: "institucional",
    title: "Institución",
    text: "Conocé la identidad, los valores y la propuesta del Club Social Varela Junior.",
    buttonLabel: "Ver Institución",
    href: "/club/institucional",
    image: "/images/ubicacion.png",
    imageAlt: "Sede del Club Social Varela Junior",
  },
  {
    id: "historia",
    title: "Nuestra Historia",
    text: "Más de un siglo fomentando el deporte y la amistad. Recorré los hitos que marcaron nuestra vida institucional.",
    buttonLabel: "Leer Historia",
    href: "/club/historia",
    image: "/images/club/historiatrofeos.png",
    imageAlt: "Foto histórica del Club Social Varela Junior",
  },
  {
    id: "autoridades",
    title: "Autoridades",
    text: "Conocé a los miembros de la Comisión Directiva que guían el rumbo del club con el compromiso de siempre.",
    buttonLabel: "Ver Autoridades",
    href: "/club/autoridades",
    image: "/images/club/autoriadadsala.png",
    imageAlt: "Comisión Directiva del Club Social Varela Junior",
  },
];

const banners = allBanners.filter(b => b.id !== exclude).slice(0, 2);
---

<section class="bg-white py-20 sm:py-28" aria-labelledby="club-cta-title" id="club-cta">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <header class="text-center" data-reveal>
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-vj-green">Conocé más</p>
      <h2
        id="club-cta-title"
        class="mt-2 text-4xl font-black uppercase tracking-tight text-slate-900 sm:text-5xl"
      >
        Explorá el Club
      </h2>
    </header>

    <!-- Banners grid -->
    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
      {banners.map((banner, idx) => (
        <a
          href={banner.href}
          class="club-cta-banner group relative block aspect-[16/10] overflow-hidden bg-slate-900 shadow-xl transition-shadow duration-300 hover:shadow-2xl md:aspect-[16/11]"
          data-reveal
          data-reveal-delay={String(idx * 150)}
        >
          <!-- Background image -->
          <img
            src={banner.image}
            alt={banner.imageAlt}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />

          <!-- Overlay -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-slate-900/95 via-slate-900/60 to-slate-900/20 transition-colors duration-300 group-hover:from-slate-900/98 group-hover:via-slate-900/70"
            aria-hidden="true"
          ></div>

          <!-- Content -->
          <div class="relative flex h-full flex-col justify-end p-8 sm:p-10">
            <!-- Accent line -->
            <div class="h-1 w-10 bg-vj-green transition-all duration-300 group-hover:w-16" aria-hidden="true"></div>

            <h3 class="mt-5 font-display text-3xl font-extrabold uppercase tracking-wide text-white sm:text-4xl">
              {banner.title}
            </h3>

            <p class="mt-3 max-w-sm text-sm leading-relaxed text-slate-300 sm:text-base">
              {banner.text}
            </p>

            <!-- Button -->
            <div class="mt-6">
              <span class="inline-flex items-center gap-2 bg-vj-green px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-lg transition-all duration-200 group-hover:bg-vj-green-600 group-hover:shadow-vj-green/30">
                {banner.buttonLabel}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  <path d="M5 12h14"></path>
                  <path d="m13 5 7 7-7 7"></path>
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
