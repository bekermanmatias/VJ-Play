---
interface Props {
  imageUrl?: string;
  imageAlt?: string;
}

const {
  imageUrl = "/images/club/hero-institucional.png",
  imageAlt = "Fachada de la Sede Central del Club Social Varela Junior",
} = Astro.props;
---

<section
  class="relative w-full min-h-[65vh] overflow-hidden bg-slate-900 md:min-h-[75vh]"
  aria-label="Banner institucional"
  id="club-hero"
>
  <!-- Background image with parallax -->
  <div class="absolute inset-0 overflow-hidden">
    <img
      src={imageUrl}
      alt={imageAlt}
      class="absolute inset-0 h-[130%] w-full object-cover will-change-transform"
      loading="eager"
      decoding="async"
      data-club-hero-img
    />
  </div>

  <!-- Overlays -->
  <div
    class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/20"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-gradient-to-tr from-vj-green/20 via-transparent to-transparent mix-blend-multiply"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="relative mx-auto flex min-h-[65vh] max-w-7xl items-center px-4 sm:px-6 lg:px-8 md:min-h-[75vh]">
    <div class="max-w-3xl py-16 text-white">
      <!-- Eyebrow -->
      <p class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-[0.2em] text-vj-green sm:text-base">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 sm:h-5 sm:w-5" aria-hidden="true">
          <path d="M3 21h18"></path>
          <path d="M5 21V7l8-4v18"></path>
          <path d="M19 21V11l-6-4"></path>
          <path d="M9 9v.01"></path>
          <path d="M9 12v.01"></path>
          <path d="M9 15v.01"></path>
          <path d="M9 18v.01"></path>
        </svg>
        Club Social Varela Junior
      </p>

      <!-- Title -->
      <h1 class="mt-5 font-display uppercase leading-none tracking-tight">
        <span class="block text-6xl font-extrabold text-white drop-shadow-md sm:text-7xl md:text-8xl lg:text-9xl">
          Institucional
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 max-w-xl text-lg font-medium leading-relaxed text-white/85 sm:text-xl">
        Conocé la identidad, los valores y la propuesta del Club Social Varela Junior.
      </p>

      <!-- Animated decorative line -->
      <div
        class="mt-8 h-1 w-32 bg-vj-green sm:w-48"
        data-line-grow
        aria-hidden="true"
      ></div>

      <!-- Scroll hint -->
      <div class="mt-10 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.15em] text-white/50 sm:mt-14">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 animate-bounce" aria-hidden="true">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
        Descubrí más
      </div>
    </div>
  </div>
</section>
