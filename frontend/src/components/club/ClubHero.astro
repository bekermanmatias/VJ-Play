---
interface Props {
  imageUrl?: string;
  imageAlt?: string;
  imagePosition?: string;
  title?: string;
  subtitle?: string;
}

const {
  imageUrl = "/images/ubicacion.png",
  imageAlt = "Fachada de la Sede Central del Club Social Varela Junior",
  imagePosition = "object-center",
  title = "Institución",
  subtitle = "Conocé la identidad, los valores y la propuesta del Club Social Varela Junior.",
} = Astro.props;
---

<section
  class="relative w-full min-h-[calc(100vh-290px)] overflow-hidden bg-slate-900"
  aria-label="Banner institucional"
  id="club-hero"
>
  <!-- Background image with parallax -->
  <div class="absolute inset-0 overflow-hidden">
    <img
      src={imageUrl}
      alt={imageAlt}
      class={`absolute inset-0 h-[130%] w-full object-cover will-change-transform ${imagePosition}`}
      loading="eager"
      decoding="async"
      data-club-hero-img
    />
  </div>

  <!-- Overlays -->
  <div
    class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/20"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-gradient-to-tr from-vj-green/20 via-transparent to-transparent mix-blend-multiply"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="relative mx-auto flex min-h-[calc(100vh-290px)] max-w-7xl items-center px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl py-16 text-white">

      <!-- Title -->
      <h1 class="mt-5 font-display uppercase leading-none tracking-tight">
        <span class="block text-6xl font-extrabold text-white drop-shadow-md sm:text-7xl md:text-8xl lg:text-9xl">
          {title}
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 max-w-xl text-lg font-medium leading-relaxed text-white/85 sm:text-xl">
        {subtitle}
      </p>

      <!-- Animated decorative line -->
      <div
        class="mt-8 h-1 w-32 bg-vj-green sm:w-48"
        data-line-grow
        aria-hidden="true"
      ></div>


    </div>
  </div>
</section>
