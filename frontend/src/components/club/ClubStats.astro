---
// Franja de cifras
---

<section class="bg-vj-green py-10" aria-label="Cifras del club">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 divide-y divide-white/20 md:divide-y-0 md:divide-x">
      
      <!-- Cifra 1 -->
      <div class="flex flex-col items-center justify-center text-center px-4 py-4 md:py-0">
        <span class="font-display text-5xl font-black text-white drop-shadow-sm">+115</span>
        <span class="mt-2 text-xs font-bold uppercase tracking-[0.15em] text-white/90">Años de historia</span>
      </div>

      <!-- Cifra 2 -->
      <div class="flex flex-col items-center justify-center text-center px-4 py-4 md:py-0">
        <span class="font-display text-5xl font-black text-white drop-shadow-sm">+10</span>
        <span class="mt-2 text-xs font-bold uppercase tracking-[0.15em] text-white/90">Disciplinas</span>
      </div>

      <!-- Cifra 3 -->
      <div class="flex flex-col items-center justify-center text-center px-4 py-4 md:py-0">
        <span class="font-display text-5xl font-black text-white drop-shadow-sm">2</span>
        <span class="mt-2 text-xs font-bold uppercase tracking-[0.15em] text-white/90">Sedes</span>
      </div>

      <!-- Cifra 4 -->
      <div class="flex flex-col items-center justify-center text-center px-4 py-4 md:py-0">
        <span class="flex h-[48px] items-center text-white drop-shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </span>
        <span class="mt-2 text-xs font-bold uppercase tracking-[0.15em] text-white/90">Entidad de bien público</span>
      </div>

    </div>
  </div>
</section>
