---
import {
  fetchPublicNews,
  getNewsApiBase,
  NEWS_DEPORTE_PREVIEW_SIZE,
  newsCategoryLabel,
  newsDate,
  newsHref,
  newsImageOrPlaceholder,
  noticiasListHref,
  type News,
} from "@/utils/news-api";

interface Props {
  /** Slug del deporte (= categoría) en news_categories. */
  categorySlug: string;
  /** Nombre tipo título del deporte (ej. "Pádel"). */
  displayName: string;
}

const { categorySlug, displayName } = Astro.props;

const apiBase = getNewsApiBase();
let news: News[] = [];
let total = 0;
let loadError = false;
try {
  const result = await fetchPublicNews(apiBase, {
    categorySlug,
    limit: NEWS_DEPORTE_PREVIEW_SIZE,
  });
  news = result.news;
  total = result.total;
} catch {
  loadError = true;
}
const hasNews = news.length > 0;
const hasMore = total > NEWS_DEPORTE_PREVIEW_SIZE;
const verMasHref = noticiasListHref({ categorySlug });
---

<section
  class="bg-white border-t border-slate-200"
  aria-label={`Noticias sobre ${displayName}`}
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-vj-green">Novedades</p>
        <h2 class="mt-2 text-3xl font-black uppercase tracking-tight text-slate-900 sm:text-4xl">
          Noticias sobre {displayName}
        </h2>
        {!hasNews && (
          <p class="mt-2 max-w-xl text-sm text-slate-600 sm:text-base">
            {loadError
              ? "No se pudieron cargar las noticias."
              : `Todavía no hay noticias publicadas para ${displayName}.`}
          </p>
        )}
      </div>
      {
        hasMore && (
          <a
            href={verMasHref}
            class="inline-flex w-fit items-center gap-2 border border-slate-300 bg-white px-3.5 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-slate-700 transition hover:border-vj-green hover:text-vj-green"
          >
            Ver más
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-3.5 w-3.5"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="m13 5 7 7-7 7" />
            </svg>
          </a>
        )
      }
    </header>

    {
      hasNews && (
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {news.map((n) => (
            <article class="group flex flex-col overflow-hidden border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
              <a href={newsHref(n)} class="block">
                <div class="aspect-[16/10] w-full bg-slate-100 overflow-hidden">
                  <img
                    src={newsImageOrPlaceholder(n)}
                    alt={n.images[0]?.altText ?? n.title}
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </a>
              <div class="flex flex-1 flex-col p-5">
                <div class="flex items-center justify-between gap-3">
                  <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-vj-green">
                    {newsCategoryLabel(n)}
                  </span>
                  <span class="shrink-0 text-[11px] text-slate-400">
                    {newsDate(n)}
                  </span>
                </div>
                <h3 class="mt-2 text-lg font-extrabold leading-snug text-slate-900">
                  <a href={newsHref(n)} class="hover:underline">
                    {n.title}
                  </a>
                </h3>
                {n.summary && (
                  <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-slate-600">
                    {n.summary}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>

        {
          hasMore && (
            <div class="mt-8 flex justify-center sm:hidden">
              <a
                href={verMasHref}
                class="inline-flex items-center gap-2 border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold uppercase tracking-[0.14em] text-slate-700 transition hover:border-vj-green hover:text-vj-green"
              >
                Ver más
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="h-3.5 w-3.5"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="m13 5 7 7-7 7" />
                </svg>
              </a>
            </div>
          )
        }
      )
    }
  </div>
</section>
