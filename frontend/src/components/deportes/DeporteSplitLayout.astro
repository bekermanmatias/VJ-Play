---
import type { DeportePageData } from "@/data/deportes";
import ActivityPage from "@/components/activities/ActivityPage.astro";
import ActivitySchedule from "@/components/activities/ActivitySchedule.astro";
import ActivityContact from "@/components/activities/ActivityContact.astro";

interface Props { data: DeportePageData }
const { data } = Astro.props;
const phones = data.contactPhones?.length
  ? data.contactPhones
  : data.contactPhone && data.contactPhoneHref
    ? [{ phone: data.contactPhone, phoneHref: data.contactPhoneHref }]
    : [];
---
<ActivityPage id="deporte-title" eyebrow="Deportes" title={data.title} imageSrc={data.imageSrc} imageAlt={data.imageAlt} imageWidth={data.imageWidth} imageHeight={data.imageHeight}>
  <div slot="description" class="mt-8 max-w-xl space-y-4 text-sm leading-relaxed text-slate-300 sm:text-base">
    {data.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <ActivitySchedule slot="details" title={data.scheduleTitle} items={data.scheduleItems} groups={data.scheduleGroups} />
  <ActivityContact slot="contact" label={data.contactLabel} phones={phones} whatsappUrl={data.whatsappUrl} instagramUrl={data.instagramUrl} showUnavailable />
</ActivityPage>
