---
import type { EspacioPageData } from "@/data/espacios";
import ActivityPage from "@/components/activities/ActivityPage.astro";
import ActivitySchedule from "@/components/activities/ActivitySchedule.astro";
import ActivityContact from "@/components/activities/ActivityContact.astro";

interface Props { data: EspacioPageData }
const { data } = Astro.props;
const phones = data.contactPhones?.length
  ? data.contactPhones
  : data.contactPhone && data.contactPhoneHref
    ? [{ phone: data.contactPhone, phoneHref: data.contactPhoneHref }]
    : [];
---
<ActivityPage id="espacio-title" eyebrow="Espacios" title={data.title} imageSrc={data.imageSrc} imageAlt={data.imageAlt} imageWidth={data.imageWidth} imageHeight={data.imageHeight}>
  <div slot="description" class="mt-8 max-w-xl space-y-4 text-sm leading-relaxed text-slate-300 sm:text-base">
    {data.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <div slot="details">
    {data.featuresTitle && data.features?.length && (
      <div class="mt-8 max-w-xl">
        <h2 class="text-sm font-bold uppercase tracking-wide text-white">{data.featuresTitle}</h2>
        <ul class="mt-3 space-y-2">
          {data.features.map((item) => <li class="flex items-center gap-3 text-sm text-slate-300 sm:text-base"><span class="inline-flex h-2.5 w-2.5 shrink-0 bg-vj-green" aria-hidden="true" />{item}</li>)}
        </ul>
      </div>
    )}
    <ActivitySchedule title={data.scheduleTitle} items={data.scheduleItems} />
  </div>
  <ActivityContact slot="contact" label={data.contactLabel} phones={phones} whatsappUrl={data.whatsappUrl} instagramUrl={data.instagramUrl} reservaHref={data.reservaHref} />
</ActivityPage>
