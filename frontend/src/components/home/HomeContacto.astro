---
import SectionHeader from "@/components/ui/SectionHeader.astro";
import ImageFallback from "@/components/ui/ImageFallback.astro";
const sedes = [
  {
    name: "Sede Central",
    image: "/images/ubicacion.png",
    imageAlt: "Sede Central del Club Social Varela Junior",
    address: "Av. Gral. José de San Martín 3275, B1889 Florencio Varela, Provincia de Buenos Aires",
    phone: "011 5364-0616",
    phoneHref: "tel:+5491153640616",
    detailsHref: "/club/sedes/sede-central",
  },
  {
    name: "Campo de Deportes",
    image: "/images/club/camporugby.png",
    imageAlt: "Campo de Deportes del Club Social Varela Junior",
    address: "Ruta Provincial 53, Florencio Varela, Provincia de Buenos Aires",
    phone: "011 5364-0616",
    phoneHref: "tel:+5491153640616",
    detailsHref: "/club/sedes/campo-deportes",
  },
];
---

<section id="contacto" class="bg-white py-16 sm:py-20 scroll-mt-32" aria-labelledby="home-contacto-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader id="home-contacto-title" eyebrow="Encontranos" title="Contacto" align="center" />

    <div class="mt-12 space-y-10">
      {sedes.map((sede, index) => {
        const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(sede.address)}`;
        return (
          <article class="grid w-full grid-cols-1 overflow-hidden bg-slate-900 text-slate-200 shadow-xl ring-1 ring-slate-800 lg:grid-cols-2" data-reveal data-reveal-delay={String(150 + index * 100)}>
            <a href={mapsHref} target="_blank" rel="noopener noreferrer" class:list={["block bg-slate-800 transition hover:opacity-95", index % 2 === 1 && "lg:order-2"]} aria-label={`Abrir ${sede.name} en Google Maps`}>
              <ImageFallback src={sede.image} alt={sede.imageAlt} class="block aspect-[16/10] w-full object-cover lg:aspect-auto lg:h-full" loading="lazy" decoding="async" />
            </a>

            <div class:list={["flex flex-col justify-center gap-6 px-6 py-10 sm:px-10 lg:px-14 lg:py-12", index % 2 === 1 && "lg:order-1"]}>
              <h3 class="font-display text-2xl font-extrabold uppercase tracking-wide text-white sm:text-3xl">{sede.name}</h3>
              <ul class="space-y-4 text-sm text-slate-300 sm:text-base">
                <li><a href={mapsHref} target="_blank" rel="noopener noreferrer" class="flex items-start gap-3 transition hover:text-white"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="mt-0.5 h-5 w-5 shrink-0 text-vj-green" aria-hidden="true"><path d="M12 22s-7-7-7-12a7 7 0 1 1 14 0c0 5-7 12-7 12Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg><span>{sede.address}</span></a></li>
                <li><a href={sede.phoneHref} class="flex items-center gap-3 transition hover:text-white" aria-label={`Llamar al ${sede.phone}`}><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0 text-vj-green" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.05-.24c1.16.39 2.42.6 3.71.6a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A18 18 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.29.21 2.55.6 3.71a1 1 0 0 1-.24 1.05l-2.24 2.03Z"></path></svg><span class="font-semibold">{sede.phone}</span></a></li>
              </ul>
              <div class="flex flex-wrap gap-3">
                <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="inline-flex w-fit items-center gap-2 border border-slate-600 bg-slate-800/60 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition hover:border-vj-green hover:bg-vj-green/10">Cómo llegar <span class="text-vj-green">→</span></a>
                <a href={sede.detailsHref} class="inline-flex w-fit items-center gap-2 bg-vj-green px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-vj-green-600">Ver más <span>→</span></a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
