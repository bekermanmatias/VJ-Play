---
import {
  fetchPublicNews,
  getNewsApiBase,
  newsCategoryLabel,
  newsDate,
  newsHref,
  newsImageOrPlaceholder,
  type News,
} from "@/utils/news-api";

const apiBase = getNewsApiBase();
let news: News[] = [];
let loadError = false;
try {
  const result = await fetchPublicNews(apiBase, { limit: 6 });
  news = result.news;
} catch {
  loadError = true;
}

const featured = news[0] ?? null;
const small = news.slice(1, 4);
const hasNews = news.length > 0;
---

<section
  class="bg-white py-16 sm:py-20"
  aria-labelledby="home-noticias-title"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-vj-green">Novedades</p>
        <h2
          id="home-noticias-title"
          class="mt-2 text-4xl font-black uppercase tracking-tight text-slate-900 sm:text-5xl"
        >
          Noticias
        </h2>
      </div>
      <a
        href="/noticias"
        class="inline-flex w-fit items-center gap-2 border border-slate-300 bg-white px-3.5 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-slate-700 transition hover:border-vj-green hover:text-vj-green"
      >
        Ver todas
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 5 7 7-7 7" />
        </svg>
      </a>
    </header>

    {
      !hasNews ? (
        <p class="mt-10 border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-sm text-slate-600">
          {loadError
            ? "No se pudieron cargar las noticias."
            : "Aún no hay noticias publicadas."}
        </p>
      ) : (
        <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2" data-reveal data-reveal-delay="150">
          {featured && (
            <a
              href={newsHref(featured)}
              class="group relative block aspect-[16/11] overflow-hidden bg-slate-900 ring-1 ring-slate-200 transition lg:aspect-auto"
            >
              <img
                src={newsImageOrPlaceholder(featured)}
                alt={featured.images[0]?.altText ?? featured.title}
                class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-slate-900/95 via-slate-900/55 to-slate-900/10"
                aria-hidden="true"
              />
              <div class="relative flex h-full flex-col justify-end p-6 sm:p-8">
                <span class="inline-flex w-fit items-center gap-2 bg-vj-green px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.16em] text-white">
                  {newsCategoryLabel(featured)}
                </span>
                <h3 class="mt-4 max-w-xl text-2xl font-black uppercase leading-tight tracking-tight text-white sm:text-3xl">
                  {featured.title}
                </h3>
                {featured.summary && (
                  <p class="mt-3 line-clamp-3 max-w-xl text-sm text-slate-200 sm:text-base">
                    {featured.summary}
                  </p>
                )}
                <p class="mt-4 text-xs text-slate-300">
                  {newsDate(featured)}
                </p>
              </div>
            </a>
          )}

          <ul class="flex flex-col divide-y divide-slate-200 border-y border-slate-200">
            {small.map((n) => (
              <li>
                <a
                  href={newsHref(n)}
                  class="group flex items-stretch gap-4 py-4 transition hover:bg-slate-50 sm:gap-5"
                >
                  <div class="relative aspect-[4/3] w-28 shrink-0 overflow-hidden bg-slate-100 sm:w-36">
                    <img
                      src={newsImageOrPlaceholder(n)}
                      alt={n.images[0]?.altText ?? n.title}
                      class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="flex min-w-0 flex-1 flex-col justify-center">
                    <div class="flex items-center justify-between gap-2">
                      <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-vj-green">
                        {newsCategoryLabel(n)}
                      </span>
                      <span class="shrink-0 text-[11px] text-slate-400">
                        {newsDate(n)}
                      </span>
                    </div>
                    <h3 class="mt-1 line-clamp-3 text-sm font-extrabold leading-snug text-slate-900 sm:text-base">
                      {n.title}
                    </h3>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
