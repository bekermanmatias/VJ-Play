---
import { cva, type VariantProps } from "class-variance-authority";

const buttonStyles = cva(
  "inline-flex items-center justify-center gap-2 border px-4 py-2.5 text-xs font-bold uppercase tracking-wider transition-colors focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-60",
  {
    variants: {
      variant: {
        primary: "border-vj-green bg-vj-green text-white hover:bg-vj-green-600",
        outline: "border-slate-300 bg-white text-slate-700 hover:border-vj-green hover:text-vj-green",
        dark: "border-slate-600 bg-slate-900/80 text-white hover:border-vj-green hover:bg-vj-green/10",
      },
    },
    defaultVariants: { variant: "primary" },
  },
);

interface Props extends VariantProps<typeof buttonStyles> {
  href?: string;
  label?: string;
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
  class?: string;
  target?: string;
  rel?: string;
}

const { href, label, disabled = false, type = "button", variant, class: extraClass, target, rel } = Astro.props;
const classes = buttonStyles({ variant, class: extraClass });
---

{href && !disabled ? (
  <a href={href} class={classes} target={target} rel={rel}><slot />{label}</a>
) : (
  <button type={type} disabled={disabled} class={classes}><slot />{label}</button>
)}
