---
import Layout from "@/layouts/Layout.astro";
import TopBar from "@/components/TopBar.astro";
import Navbar from "@/components/Navbar.astro";
import ClubHero from "@/components/club/ClubHero.astro";
import ClubCTA from "@/components/club/ClubCTA.astro";

/**
 * Lista completa de todos los presidentes históricos (sin foto).
 */
const todosLosPresidentes = [
  "Edelmiro Palacios",
  "Agustín Dubini",
  "Arnaldo Massone",
  "Juan Gregoni",
  "Amadeo Dapena",
  "Stanley Baynes",
  "Rafael Aquilano",
  "Salvador Robertazzi",
  "Eugenio Schiantarelli",
  "Ovidio Morando",
  "Enrique Albizzati",
  "Pedro Monroy",
  "José Dans Rey",
  "Felix Sosa",
  "Anastasio Villar",
  "Enrique Otero",
  "Tomás Palma",
  "Celsio Cibeira",
  "Antonio Barbalán",
  "Miguel Chimento",
  "Libio Mandirola",
  "Abel López",
  "Porfirio Lambardi",
  "Felix Rodriguez",
  "Antonio Palucito",
  "Humberto Toscanini",
  "José Casariego",
  "Antonio Guarasci",
  "José M. Mastronardi",
  "Jorge Dreyer",
  "Roberto Dogil",
  "Juan Tellechea",
  "Adolfo de la Fuente",
];
---

<Layout
  title="Autoridades | Club Social Varela Junior"
  description="A través de su largo historial, la Institución fue presidida por prestigiosos vecinos varelenses."
>
  <TopBar />
  <Navbar />

  <main class="min-h-[calc(100dvh-8.25rem)]">
    <ClubHero
      title="Autoridades"
      subtitle="A través de su largo historial, la Institución fue presidida por prestigiosos vecinos varelenses."
      imageUrl="/images/club/autoriadadsala.png"
      imageAlt="Autoridades del Club Social Varela Junior"
      imagePosition="object-[center_75%]"
    />

    <!-- Full historical list (text only) -->
    <section aria-labelledby="lista-completa-titulo">
      <div class="mx-auto max-w-6xl px-4 pb-24 pt-10 sm:px-6 lg:px-8">
        <div data-reveal>
          <h2
            id="lista-completa-titulo"
            class="font-display text-2xl font-extrabold uppercase tracking-wide text-slate-900 sm:text-3xl"
          >
            Todos los Presidentes
          </h2>
          <p class="mt-2 text-base text-slate-500">
            Listado histórico completo de quienes lideraron la institución.
          </p>
          <div class="mt-4 h-0.5 w-12 bg-vj-green" aria-hidden="true"></div>
        </div>

        <div
          class="pres-list mt-10"
          data-reveal
          data-reveal-delay="150"
        >
          {todosLosPresidentes.map((name, idx) => (
            <div class="pres-list__item">
              <span class="pres-list__num">{String(idx + 1).padStart(2, "0")}</span>
              <span class="pres-list__name">{name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ClubCTA exclude="autoridades" />
  </main>
</Layout>

<style>
  /* ─────────────────────────────────────────────────
     FULL PRESIDENTS LIST
     ───────────────────────────────────────────────── */

  .pres-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 640px) {
    .pres-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pres-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pres-list__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.5rem;
    border-bottom: 1px solid rgb(226 232 240);
    transition: background 0.2s ease;
  }

  .pres-list__item:hover {
    background: white;
  }

  .pres-list__num {
    font-family: "Anton", "Bebas Neue", system-ui, sans-serif;
    font-size: 0.8rem;
    color: rgb(1 170 85);
    min-width: 1.5rem;
    letter-spacing: 0.06em;
  }

  .pres-list__name {
    font-size: 0.9rem;
    font-weight: 600;
    color: rgb(51 65 85); /* slate-700 */
  }

</style>
