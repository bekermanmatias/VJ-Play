---
import Layout from "@/layouts/Layout.astro";
import TopBar from "@/components/TopBar.astro";
import Navbar from "@/components/Navbar.astro";
import NewsLoadMoreList from "@/components/news/NewsLoadMoreList";
import {
  fetchPublicCategories,
  fetchPublicNews,
  getNewsApiBase,
  NEWS_PAGE_SIZE,
  noticiasListHref,
  type News,
  type NewsCategory,
} from "@/utils/news-api";

export const prerender = false;

const apiBase = getNewsApiBase();
const url = Astro.url;
const categorySlug = url.searchParams.get("categoria")?.trim().toLowerCase() || "";
const search = url.searchParams.get("q")?.trim() || "";
const pageRaw = Number.parseInt(url.searchParams.get("page") ?? "1", 10);
const page = Number.isFinite(pageRaw) && pageRaw > 0 ? pageRaw : 1;

let news: News[] = [];
let categories: NewsCategory[] = [];
let total = 0;
let loadError = false;

try {
  const [list, cats, allPublished] = await Promise.all([
    fetchPublicNews(apiBase, {
      categorySlug: categorySlug || undefined,
      search: search || undefined,
      limit: NEWS_PAGE_SIZE * page,
    }),
    fetchPublicCategories(apiBase),
    fetchPublicNews(apiBase, { limit: 200 }),
  ]);
  news = list.news;
  total = list.total;

  const slugsWithNews = new Set(
    allPublished.news.flatMap((n) => n.categories.map((c) => c.slug)),
  );
  categories = cats.filter((c) => slugsWithNews.has(c.slug));
} catch {
  loadError = true;
}

const activeCategory = categorySlug
  ? categories.find((c) => c.slug === categorySlug)
  : null;

const pageTitle = activeCategory
  ? `Noticias · ${activeCategory.label} | Club Social Varela Junior`
  : "Noticias | Club Social Varela Junior";
---

<Layout title={pageTitle} description="Noticias del Club Social Varela Junior.">
  <TopBar />
  <Navbar />

  <main class="bg-white">
    <div style="background: red; color: white; padding: 10px; font-family: monospace;">DEBUG API BASE: {apiBase || "EMPTY"}</div>
    <header class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 lg:px-8 lg:pt-12" data-reveal>
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-vj-green">Novedades</p>
      <h1 class="mt-2 font-display text-4xl font-extrabold uppercase tracking-wide text-slate-900 sm:text-5xl">
        Noticias
      </h1>
      <hr class="mt-5 border-0 border-t border-dotted border-slate-300" />

      {(categories.length > 0 || !categorySlug) && (
        <nav class="mt-5 pb-6" aria-label="Filtrar por categoría">
          <ul class="flex flex-wrap items-center gap-x-1 gap-y-2">
            <li>
              <a
                href={noticiasListHref({ search: search || undefined })}
                class:list={[
                  "inline-block px-3 py-1.5 text-xs font-bold uppercase tracking-wider transition",
                  !categorySlug
                    ? "bg-vj-green text-white"
                    : "text-slate-600 hover:text-vj-green",
                ]}
                aria-current={!categorySlug ? "page" : undefined}
              >
                Todas
              </a>
            </li>
            {categories.map((c) => {
              const active = c.slug === categorySlug;
              const href = noticiasListHref({
                categorySlug: c.slug,
                search: search || undefined,
              });
              return (
                <li>
                  <a
                    href={href}
                    class:list={[
                      "inline-block px-3 py-1.5 text-xs font-bold uppercase tracking-wider transition",
                      active
                        ? "bg-vj-green text-white"
                        : "text-slate-600 hover:text-vj-green",
                    ]}
                    aria-current={active ? "page" : undefined}
                  >
                    {c.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      )}

      {search && (
        <p class="mb-4 text-sm text-slate-600">
          Resultados para «{search}» —{" "}
          <a href="/noticias" class="font-semibold text-vj-green hover:underline">
            ver todas
          </a>
        </p>
      )}
    </header>

    <section class="border-t border-slate-200 py-10 sm:py-12">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {loadError && (
          <p class="border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
            No se pudieron cargar las noticias. Probá de nuevo en unos minutos.
          </p>
        )}

        {!loadError && news.length === 0 && (
          <p class="border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-sm text-slate-600">
            No hay noticias para mostrar con estos filtros.
          </p>
        )}

        {news.length > 0 && (
          <NewsLoadMoreList
            client:load
            apiBase={apiBase}
            initialNews={news}
            initialTotal={total}
            initialPage={page}
            pageSize={NEWS_PAGE_SIZE}
            categorySlug={categorySlug || undefined}
            search={search || undefined}
          />
        )}
      </div>
    </section>
  </main>
</Layout>
