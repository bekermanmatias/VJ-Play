---
import Layout from "@/layouts/Layout.astro";
import TopBar from "@/components/TopBar.astro";
import Navbar from "@/components/Navbar.astro";
import {
  fetchPublicCategories,
  fetchPublicNews,
  getNewsApiBase,
  newsCategoryLabel,
  newsDate,
  newsHref,
  newsImageOrPlaceholder,
  type News,
  type NewsCategory,
} from "@/utils/news-api";

export const prerender = false;

const apiBase = getNewsApiBase();
const url = Astro.url;
const categorySlug = url.searchParams.get("categoria")?.trim().toLowerCase() || "";
const search = url.searchParams.get("q")?.trim() || "";

let news: News[] = [];
let categories: NewsCategory[] = [];
let total = 0;
let loadError = false;

try {
  const [list, cats] = await Promise.all([
    fetchPublicNews(apiBase, {
      categorySlug: categorySlug || undefined,
      search: search || undefined,
      limit: 24,
    }),
    fetchPublicCategories(apiBase),
  ]);
  news = list.news;
  total = list.total;
  categories = cats;
} catch {
  loadError = true;
}

const activeCategory = categorySlug
  ? categories.find((c) => c.slug === categorySlug)
  : null;

const pageTitle = activeCategory
  ? `Noticias · ${activeCategory.label} | Club Social Varela Junior`
  : "Noticias | Club Social Varela Junior";
---

<Layout title={pageTitle} description="Noticias del Club Social Varela Junior.">
  <TopBar />
  <Navbar />

  <main class="bg-white">
    <section class="bg-slate-950 text-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-vj-green">Novedades</p>
        <h1 class="mt-2 text-4xl font-black uppercase tracking-tight sm:text-5xl">
          {activeCategory ? `Noticias · ${activeCategory.label}` : "Noticias"}
        </h1>
        <p class="mt-3 max-w-2xl text-sm text-slate-300 sm:text-base">
          Novedades, resultados y actividades del club.
        </p>

        <form
          class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center"
          method="get"
          action="/noticias"
        >
          {categorySlug && (
            <input type="hidden" name="categoria" value={categorySlug} />
          )}
          <label class="sr-only" for="news-search">Buscar</label>
          <input
            id="news-search"
            type="search"
            name="q"
            value={search}
            placeholder="Buscar por título o texto…"
            class="w-full border border-white/20 bg-white/10 px-3.5 py-2.5 text-sm text-white placeholder-slate-400 outline-none ring-vj-green/40 transition focus:border-vj-green focus:ring-2 sm:max-w-md"
          />
          <button
            type="submit"
            class="bg-vj-green px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition hover:brightness-110"
          >
            Buscar
          </button>
        </form>
      </div>
    </section>

    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <ul class="-mb-px flex flex-wrap gap-2 py-4">
          <li>
            <a
              href={search ? `/noticias?q=${encodeURIComponent(search)}` : "/noticias"}
              class:list={[
                "inline-flex items-center border px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider transition",
                !categorySlug
                  ? "border-vj-green bg-vj-green text-white"
                  : "border-slate-200 text-slate-700 hover:border-vj-green hover:text-vj-green",
              ]}
            >
              Todas
            </a>
          </li>
          {categories.map((c) => {
            const active = c.slug === categorySlug;
            const href = `/noticias?categoria=${encodeURIComponent(c.slug)}${search ? `&q=${encodeURIComponent(search)}` : ""}`;
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    "inline-flex items-center border px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider transition",
                    active
                      ? "border-vj-green bg-vj-green text-white"
                      : "border-slate-200 text-slate-700 hover:border-vj-green hover:text-vj-green",
                  ]}
                >
                  {c.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <section class="bg-white py-12 sm:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {loadError && (
          <p class="border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
            No se pudieron cargar las noticias. Probá de nuevo en unos minutos.
          </p>
        )}

        {!loadError && news.length === 0 && (
          <p class="border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-sm text-slate-600">
            No hay noticias para mostrar con estos filtros.
          </p>
        )}

        {news.length > 0 && (
          <>
            <p class="text-sm text-slate-500">
              {total} noticia{total === 1 ? "" : "s"} encontrada{total === 1 ? "" : "s"}.
            </p>
            <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {news.map((n) => (
                <article class="group flex flex-col overflow-hidden border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
                  <a href={newsHref(n)} class="block">
                    <div class="aspect-[16/10] w-full bg-slate-100 overflow-hidden">
                      <img
                        src={newsImageOrPlaceholder(n)}
                        alt={n.images[0]?.altText ?? n.title}
                        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </a>
                  <div class="flex flex-1 flex-col p-5">
                    <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-vj-green">
                      {newsCategoryLabel(n)}
                    </span>
                    <h2 class="mt-2 text-lg font-extrabold leading-snug text-slate-900">
                      <a href={newsHref(n)} class="hover:underline">
                        {n.title}
                      </a>
                    </h2>
                    {n.summary && (
                      <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-slate-600">
                        {n.summary}
                      </p>
                    )}
                    <div class="mt-4 flex items-center gap-2 text-xs text-slate-400">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        class="h-3.5 w-3.5"
                        aria-hidden="true"
                      >
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <path d="M16 2v4M8 2v4M3 10h18" />
                      </svg>
                      <span>{newsDate(n)}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  </main>
</Layout>
