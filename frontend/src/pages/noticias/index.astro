---
import Layout from "@/layouts/Layout.astro";
import TopBar from "@/components/TopBar.astro";
import Navbar from "@/components/Navbar.astro";
import {
  fetchPublicCategories,
  fetchPublicNews,
  getNewsApiBase,
  newsCategoryLabel,
  newsDate,
  newsHref,
  newsImageOrPlaceholder,
  type News,
  type NewsCategory,
} from "@/utils/news-api";

export const prerender = false;

const apiBase = getNewsApiBase();
const url = Astro.url;
const categorySlug = url.searchParams.get("categoria")?.trim().toLowerCase() || "";
const search = url.searchParams.get("q")?.trim() || "";

let news: News[] = [];
let categories: NewsCategory[] = [];
let total = 0;
let loadError = false;

try {
  const [list, cats, allPublished] = await Promise.all([
    fetchPublicNews(apiBase, {
      categorySlug: categorySlug || undefined,
      search: search || undefined,
      limit: 24,
    }),
    fetchPublicCategories(apiBase),
    fetchPublicNews(apiBase, { limit: 200 }),
  ]);
  news = list.news;
  total = list.total;

  const slugsWithNews = new Set(
    allPublished.news.flatMap((n) => n.categories.map((c) => c.slug)),
  );
  categories = cats.filter((c) => slugsWithNews.has(c.slug));
} catch {
  loadError = true;
}

const activeCategory = categorySlug
  ? categories.find((c) => c.slug === categorySlug)
  : null;

const pageTitle = activeCategory
  ? `Noticias · ${activeCategory.label} | Club Social Varela Junior`
  : "Noticias | Club Social Varela Junior";
---

<Layout title={pageTitle} description="Noticias del Club Social Varela Junior.">
  <TopBar />
  <Navbar />

  <main class="bg-white">
    <header class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 lg:px-8 lg:pt-12">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-vj-green">Novedades</p>
      <h1 class="mt-2 font-display text-4xl font-extrabold uppercase tracking-wide text-slate-900 sm:text-5xl">
        Noticias
      </h1>
      <hr class="mt-5 border-0 border-t border-dotted border-slate-300" />

      {(categories.length > 0 || !categorySlug) && (
        <nav class="mt-5 pb-6" aria-label="Filtrar por categoría">
          <ul class="flex flex-wrap items-center gap-x-1 gap-y-2">
            <li>
              <a
                href={search ? `/noticias?q=${encodeURIComponent(search)}` : "/noticias"}
                class:list={[
                  "inline-block px-3 py-1.5 text-xs font-bold uppercase tracking-wider transition",
                  !categorySlug
                    ? "bg-vj-green text-white"
                    : "text-slate-600 hover:text-vj-green",
                ]}
                aria-current={!categorySlug ? "page" : undefined}
              >
                Todas
              </a>
            </li>
            {categories.map((c) => {
              const active = c.slug === categorySlug;
              const href = `/noticias?categoria=${encodeURIComponent(c.slug)}${search ? `&q=${encodeURIComponent(search)}` : ""}`;
              return (
                <li>
                  <a
                    href={href}
                    class:list={[
                      "inline-block px-3 py-1.5 text-xs font-bold uppercase tracking-wider transition",
                      active
                        ? "bg-vj-green text-white"
                        : "text-slate-600 hover:text-vj-green",
                    ]}
                    aria-current={active ? "page" : undefined}
                  >
                    {c.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      )}

      {search && (
        <p class="mb-4 text-sm text-slate-600">
          Resultados para «{search}» —{" "}
          <a href="/noticias" class="font-semibold text-vj-green hover:underline">
            ver todas
          </a>
        </p>
      )}
    </header>

    <section class="border-t border-slate-200 py-10 sm:py-12">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {loadError && (
          <p class="border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
            No se pudieron cargar las noticias. Probá de nuevo en unos minutos.
          </p>
        )}

        {!loadError && news.length === 0 && (
          <p class="border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-sm text-slate-600">
            No hay noticias para mostrar con estos filtros.
          </p>
        )}

        {news.length > 0 && (
          <>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {news.map((n) => (
                <article class="group flex flex-col overflow-hidden border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
                  <a href={newsHref(n)} class="block">
                    <div class="aspect-[16/10] w-full bg-slate-100 overflow-hidden">
                      <img
                        src={newsImageOrPlaceholder(n)}
                        alt={n.images[0]?.altText ?? n.title}
                        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </a>
                  <div class="flex flex-1 flex-col p-5">
                    <div class="flex items-center justify-between gap-3">
                      <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-vj-green">
                        {newsCategoryLabel(n)}
                      </span>
                      <span class="flex shrink-0 items-center gap-1.5 text-[11px] text-slate-400">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          class="h-3 w-3"
                          aria-hidden="true"
                        >
                          <rect x="3" y="4" width="18" height="18" rx="2" />
                          <path d="M16 2v4M8 2v4M3 10h18" />
                        </svg>
                        {newsDate(n)}
                      </span>
                    </div>
                    <h2 class="mt-2 text-lg font-extrabold leading-snug text-slate-900">
                      <a href={newsHref(n)} class="hover:underline">
                        {n.title}
                      </a>
                    </h2>
                    {n.summary && (
                      <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-slate-600">
                        {n.summary}
                      </p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  </main>
</Layout>
