---
import Layout from "@/layouts/Layout.astro";
import TopBar from "@/components/TopBar.astro";
import Navbar from "@/components/Navbar.astro";
import { getReplayApiBaseFromEnv } from "@/utils/replay-api-base";

export const prerender = false;

const apiBase = getReplayApiBaseFromEnv();
const accessToken = Astro.url.searchParams.get("token") ?? "";
const cinema = Astro.url.searchParams.get("cinema") === "1";
---

<Layout title="Ver Replay | Club Social Varela Junior">
  {!cinema && <TopBar />}
  {!cinema && <Navbar />}

  <main class={cinema ? "min-h-dvh bg-black" : "min-h-[calc(100vh-7rem)] bg-white"}>
    {!accessToken ? (
      <div class="mx-auto max-w-lg px-4 py-12 sm:px-6 lg:px-8">
        <div class="border border-rose-200 bg-white p-6 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-rose-700">Error</p>
          <h2 class="mt-2 text-xl font-black tracking-tight text-slate-900">Link inválido</h2>
          <p class="mt-2 text-sm text-slate-600">
            Este link no contiene un token de acceso válido.
          </p>
          <a
            href="/replays"
            class="mt-5 inline-flex h-11 w-full items-center justify-center bg-vj-green px-4 text-sm font-black uppercase tracking-wider text-white transition hover:bg-vj-green-600"
          >
            Ir al buscador de partidos
          </a>
        </div>
      </div>
    ) : (
      <div id="ver-replay-root"
           data-api-base={apiBase}
           data-access-token={accessToken}
           data-cinema={cinema ? "1" : "0"}>
        <div class="flex min-h-[50vh] items-center justify-center">
          <p class="text-sm font-semibold text-slate-600">Cargando replay...</p>
        </div>
      </div>
    )}
  </main>
</Layout>

<script>
  import { createElement } from "react";
  import { createRoot } from "react-dom/client";

  // We need to dynamically resolve the matchKey from the accessToken, then render the player.
  const root = document.getElementById("ver-replay-root");
  if (root) {
    const apiBase = (root.dataset.apiBase ?? "").replace(/\/$/, "");
    const accessToken = root.dataset.accessToken ?? "";
    const cinema = root.dataset.cinema === "1";

    async function init() {
      try {
        // 1. Validate access token and get session + matchKey
        const res = await fetch(`${apiBase}/api/replays/payment/access`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ accessToken }),
        });
        const body = await res.json().catch(() => null) as {
          sessionToken?: string;
          matchKey?: string;
          error?: string;
        } | null;

        if (!res.ok || !body?.sessionToken || !body?.matchKey) {
          const errorMsg = body?.error ?? "No se pudo validar el acceso";
          root!.innerHTML = `
            <div class="mx-auto max-w-lg px-4 py-12 sm:px-6 lg:px-8">
              <div class="border border-rose-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-rose-700">Acceso</p>
                <h2 class="mt-2 text-xl font-black tracking-tight text-slate-900">No se pudo acceder</h2>
                <p class="mt-2 text-sm text-slate-600">${errorMsg}</p>
                <a href="/replays"
                   class="mt-5 inline-flex h-11 w-full items-center justify-center bg-vj-green px-4 text-sm font-black uppercase tracking-wider text-white transition hover:bg-vj-green-600">
                  Ir al buscador de partidos
                </a>
              </div>
            </div>
          `;
          return;
        }

        // 2. Save session token so the player pipeline works
        try {
          sessionStorage.setItem(
            `vj_replay_sess:${body.matchKey}`,
            JSON.stringify({ matchKey: body.matchKey, token: body.sessionToken }),
          );
        } catch { /* ignore */ }

        // 3. Look up the match numeric ID to render ReplayPartidoById
        const matchByKeyUrl = new URL(`${apiBase}/api/replays/access/exists`);
        matchByKeyUrl.searchParams.set("matchKey", body.matchKey);
        const matchRes = await fetch(matchByKeyUrl.toString());
        const matchBody = await matchRes.json().catch(() => null) as {
          exists?: boolean;
          numericId?: number;
        } | null;

        const numericId = typeof matchBody?.numericId === "number" ? matchBody.numericId : null;

        // 4. Dynamically import and render ReplayPartidoById
        const { default: ReplayPartidoById } = await import("@/components/replays/ReplayPartidoById");

        const reactRoot = createRoot(root!);
        reactRoot.render(
          createElement(ReplayPartidoById, {
            apiBase,
            cinema,
            matchId: numericId,
            accessToken,
          }),
        );
      } catch (e) {
        root!.innerHTML = `
          <div class="mx-auto max-w-lg px-4 py-12 sm:px-6 lg:px-8">
            <div class="border border-rose-200 bg-white p-6 shadow-sm">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-rose-700">Error</p>
              <h2 class="mt-2 text-xl font-black tracking-tight text-slate-900">Error inesperado</h2>
              <p class="mt-2 text-sm text-slate-600">${e instanceof Error ? e.message : "Ocurrió un error al cargar el replay."}</p>
              <a href="/replays"
                 class="mt-5 inline-flex h-11 w-full items-center justify-center bg-vj-green px-4 text-sm font-black uppercase tracking-wider text-white transition hover:bg-vj-green-600">
                Ir al buscador
              </a>
            </div>
          </div>
        `;
      }
    }

    init();
  }
</script>
