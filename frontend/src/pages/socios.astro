---
import Layout from "@/layouts/Layout.astro";
import TopBar from "@/components/TopBar.astro";
import Navbar from "@/components/Navbar.astro";
import ClubHero from "@/components/club/ClubHero.astro";

const ALTA_URL =
  "https://micuenta.gest-gym.com/altas.aspx?acc=T1pGejlnMUtSS2lPNTVQeTlXb1lRQT09";

const cuotas = [
  { categoria: "Activos",         rango: "18 años o más", precio: "$12.000" },
  { categoria: "Activas",         rango: "18 años o más", precio: "$12.000" },
  { categoria: "Cadetes Mayores", rango: "14 a 17 años",  precio: "$10.000" },
  { categoria: "Cadetes Menores", rango: "6 a 13 años",   precio: "$10.000" },
  { categoria: "Cadetas",         rango: "6 a 17 años",   precio: "$10.000" },
];

const requisitos = [
  "Nombre y apellido completo",
  "DNI",
  "Teléfono de contacto",
  "Dirección de e-mail",
  "Domicilio",
  "Foto digital tipo carnet",
];

const pasos = [
  {
    num: "01",
    title: "Completá el formulario online",
    desc: "Ingresá a nuestra plataforma de autogestión y completá el alta desde cualquier dispositivo.",
  },
  {
    num: "02",
    title: "Tené tu documentación a mano",
    desc: "Necesitás tu DNI, un e-mail vigente y una foto digital tipo carnet para finalizar el registro.",
  },
  {
    num: "03",
    title: "Cargá tus datos y abonás",
    desc: "Completá el formulario con tu información personal y abonás la inscripción junto con la primera cuota.",
  },
];
---

<Layout
  title="Asociarme | Club Social Varela Junior"
  description="Sumate al Club Social Varela Junior. Conocé las cuotas, categorías y cómo asociarte de forma online."
>
  <TopBar />
  <Navbar />

  <main>
    <!-- ═══ HERO ═══ -->
    <ClubHero
      title="Asociarme"
      subtitle="Formá parte de una comunidad con más de un siglo de historia. Deportes, cultura y familia en un solo lugar."
      imageUrl="/images/club/camporugby.png"
      imageAlt="Socios del Club Social Varela Junior"
      imageClass="h-full object-cover"
    />

    <!-- ═══ CUOTAS Y CATEGORÍAS ═══ -->
    <section
      id="cuotas"
      class="bg-white py-20 sm:py-28"
      aria-labelledby="cuotas-h2"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Header -->
        <div class="mb-14" data-reveal>
          <p class="text-xs font-bold uppercase tracking-[0.22em] text-vj-green">
            Socios
          </p>
          <h2
            id="cuotas-h2"
            class="mt-2 font-display text-3xl font-extrabold uppercase tracking-wide text-slate-900 sm:text-4xl"
          >
            Cuotas y Categorías
          </h2>
          <p class="mt-2 text-base text-slate-500">
            Valores mensuales sujetos a actualización.
          </p>
          <div class="mt-4 h-0.5 w-12 bg-vj-green" aria-hidden="true"></div>
        </div>

        <!-- Grid de cuotas -->
        <div
          class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5"
          data-reveal
          data-reveal-delay="100"
        >
          {cuotas.map((c) => (
            <div class="group border border-slate-200 border-t-4 border-t-vj-green bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
              <p class="font-display text-lg font-extrabold uppercase tracking-wide text-slate-900">
                {c.categoria}
              </p>
              <p class="mt-1 text-xs font-bold uppercase tracking-widest text-slate-400">
                {c.rango}
              </p>
              <p class="mt-4 font-display text-4xl font-black text-vj-green leading-none">
                {c.precio}
              </p>
              <p class="mt-1 text-xs font-bold uppercase tracking-widest text-slate-400">
                / mes
              </p>
            </div>
          ))}
        </div>

        <!-- Nota -->
        <div
          class="mt-6 flex items-start gap-3 border-l-4 border-vj-green bg-green-50 px-5 py-4 text-sm text-slate-700"
          data-reveal
          data-reveal-delay="150"
          role="note"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mt-0.5 h-4 w-4 flex-shrink-0 text-vj-green"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <p>
            <strong>La inscripción tiene el mismo valor que la cuota social.</strong>
            {" "}Valores mensuales sujetos a actualización.
          </p>
        </div>

      </div>
    </section>

    <!-- ═══ CÓMO ASOCIARTE ═══ -->
    <section
      id="como-asociarte"
      class="bg-slate-900 py-20 sm:py-28"
      aria-labelledby="pasos-h2"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Header -->
        <div class="mb-14" data-reveal>
          <p class="text-xs font-bold uppercase tracking-[0.22em] text-vj-green">
            Proceso de alta
          </p>
          <h2
            id="pasos-h2"
            class="mt-2 font-display text-3xl font-extrabold uppercase tracking-wide text-white sm:text-4xl"
          >
            Cómo Asociarte
          </h2>
          <p class="mt-2 text-base text-slate-400">
            En solo tres pasos te convertís en socio/a del club.
          </p>
          <div class="mt-4 h-0.5 w-12 bg-vj-green" aria-hidden="true"></div>
        </div>

        <!-- Pasos -->
        <ol
          class="grid grid-cols-1 gap-10 md:grid-cols-3"
          aria-label="Pasos para asociarte"
        >
          {pasos.map((p, idx) => (
            <li
              class="relative flex flex-col"
              data-reveal
              data-reveal-delay={String(idx * 120)}
            >
              {/* Separador vertical entre pasos en desktop */}
              {idx < pasos.length - 1 && (
                <div
                  class="absolute right-0 top-0 hidden h-full w-px bg-slate-700 md:block"
                  aria-hidden="true"
                />
              )}
              <span class="font-display text-6xl font-black leading-none text-vj-green opacity-90">
                {p.num}
              </span>
              <div class="mt-4 pr-8">
                <h3 class="text-base font-extrabold text-white leading-snug">
                  {p.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">
                  {p.desc}
                </p>
              </div>
            </li>
          ))}
        </ol>

        <!-- CTA centrado -->
        <div class="mt-12 flex justify-center" data-reveal data-reveal-delay="360">
          <a
            id="btn-paso1-alta"
            href={ALTA_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-vj-green px-7 py-3.5 text-xs font-bold uppercase tracking-widest text-white shadow-lg transition-all duration-200 hover:bg-vj-green-600 hover:shadow-vj-green/30"
          >
            Ir al formulario
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        </div>

      </div>
    </section>

    <!-- ═══ REQUISITOS ═══ -->
    <section
      id="requisitos"
      class="bg-white py-20 sm:py-28"
      aria-labelledby="req-h2"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Header -->
        <div class="mb-14" data-reveal>
          <p class="text-xs font-bold uppercase tracking-[0.22em] text-vj-green">
            Documentación
          </p>
          <h2
            id="req-h2"
            class="mt-2 font-display text-3xl font-extrabold uppercase tracking-wide text-slate-900 sm:text-4xl"
          >
            Requisitos
          </h2>
          <p class="mt-2 text-base text-slate-500">
            Para completar el alta vas a necesitar tener a mano:
          </p>
          <div class="mt-4 h-0.5 w-12 bg-vj-green" aria-hidden="true"></div>
        </div>

        <!-- Lista de requisitos -->
        <ul
          class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3"
          role="list"
          data-reveal
          data-reveal-delay="100"
        >
          {requisitos.map((item) => (
            <li class="flex items-center gap-3 border border-slate-100 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700 transition-colors duration-200 hover:border-green-200 hover:bg-green-50">
              <span
                class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-vj-green"
                aria-hidden="true"
              />
              {item}
            </li>
          ))}
        </ul>

      </div>
    </section>

    <!-- ═══ CTA FINAL ═══ -->
    <section class="bg-slate-900 border-t border-slate-800 py-20" aria-label="Acción final">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div
          class="flex flex-col items-start gap-8 md:flex-row md:items-center md:justify-between"
          data-reveal
        >
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-vj-green">
              Unite hoy
            </p>
            <h2 class="mt-2 font-display text-3xl font-extrabold uppercase tracking-wide text-white sm:text-4xl">
              ¿Listo para ser parte?
            </h2>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-400">
              El alta se completa en minutos desde cualquier dispositivo.
              No necesitás venir al club para empezar.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              id="btn-cta-alta"
              href={ALTA_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-vj-green px-7 py-3.5 text-xs font-bold uppercase tracking-widest text-white shadow-lg transition-all duration-200 hover:bg-vj-green-600 hover:shadow-vj-green/30"
            >
              Asociate ahora
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>

            <button
              id="btn-portal-socio"
              type="button"
              disabled
              title="Próximamente"
              class="inline-flex cursor-not-allowed items-center gap-2 border border-slate-700 px-7 py-3.5 text-xs font-bold uppercase tracking-widest text-slate-500 opacity-60"
            >
              ¿Ya sos socio? Ingresá al portal
            </button>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>
